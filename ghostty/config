# Ghostty config - migrated from iTerm2
# Generated from com.googlecode.iterm2.plist

# ==========================================
# Ghostty macOS Dock icon style options

# 1. Official (the default gray ghost)
# macos-icon = official

# 2. Blueprint (engineering ghost on a grid blueprint background)
# macos-icon = blueprint

# 3. Chalkboard (chalk-drawn ghost on a dark green chalkboard)
# macos-icon = chalkboard

# 4. Glass (translucent, light-catching glass material)
# macos-icon = glass

# 5. Holographic (metallic ghost with iridescent aurora reflections)
macos-icon = holographic

# 6. Microchip (green silicon circuit board motif)
# macos-icon = microchip

# 7. Paper (soft paper-craft texture)
# macos-icon = paper

# 8. Retro (analog ghost in an 8-bit classic computer screen style)
# macos-icon = retro

# 9. X-ray (see-through style revealing the inner skeleton layer)
# macos-icon = xray
# ==========================================

confirm-close-surface = false

# Font
font-family = "MesloLGSDZ Nerd Font"
font-size = 13
# font-thicken = true

window-colorspace = display-p3
# Colors
background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #000000
selection-background = #b4d4ff
selection-foreground = #000000

# Cursor style
cursor-style = block
cursor-style-blink = false

# Use bright palette colors for bold text (replaces bold-is-bright, deprecated since 1.2.0)
bold-color = bright

# Remove dark fringing around red/green text edges
alpha-blending = linear-corrected

# ANSI palette
palette = 0=#000000
palette = 1=#ff5454
palette = 2=#54ff54
palette = 3=#ffff54
palette = 4=#5454ff
palette = 5=#ff54ff
palette = 6=#54ffff
palette = 7=#bababa
palette = 8=#545454
palette = 9=#ff5454
palette = 10=#54ff54
palette = 11=#ffff54
palette = 12=#5454ff
palette = 13=#ff54ff
palette = 14=#54ffff
palette = 15=#ffffff

# Window
window-width = 125
window-height = 35

# window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
# window-padding-color = extend

# Save window state
window-save-state = always

# Move cursor by clicking
cursor-click-to-move = true

# Titlebar
macos-titlebar-style = hidden

# Option key (iTerm2: left option sends Esc+)
macos-option-as-alt = left

# Scrollback (since 1.4.0 scrollback-limit is interpreted as bytes, so set lines explicitly)
scrollback-limit-lines = 100000
scrollback-limit-bytes = unlimited

adjust-cell-height =  3%

adjust-cell-width = 3%

adjust-font-baseline = 0

font-codepoint-map = U+AC00-U+D7A3,U+1100-U+11FF,U+3130-U+318F=Noto Sans CJK KR

# Automatically copy terminfo when connecting to remote servers
shell-integration-features = ssh-env,ssh-terminfo

# Uncomment the line below only if you hit compatibility issues
# (remote sessions are handled automatically by ssh-env/ssh-terminfo)
# term = xterm-256color

# Grapheme width for Hangul/emoji. Revert to legacy if the prompt cursor gets misaligned
# grapheme-width-method = legacy
grapheme-width-method = unicode

# macOS notification when a long command (10s+) finishes while the window is unfocused
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# Keep zoom state when navigating between splits
split-preserve-zoom = navigation

# Quick terminal (global hotkey, requires Accessibility permission)
keybind = global:option+grave_accent=toggle_quick_terminal
